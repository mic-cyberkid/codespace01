{
  "name": "Android Dev Codespace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.java",
        "ms-vscode.cpptools"
      ]
    }
  },
  "forwardPorts": [5037, 8080],
  "remoteUser": "vscode"
}
